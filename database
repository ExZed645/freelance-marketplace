-- Query 1: List of open projects along with their category and employer information[cite: 2]
SELECT 
    p.id AS project_id,
    p.title AS project_title,
    p.budget,
    p.status,
    c.name AS category_name,
    u.first_name || ' ' || u.last_name AS employer_name,
    u.email AS employer_email
FROM projects p
JOIN users u ON p.employer_id = u.id
JOIN project_categories pc ON p.id = pc.project_id
JOIN categories c ON pc.category_id = c.id
WHERE p.status = 'Open';

-- Query 3: Count of projects posted by each employer[cite: 2]
SELECT 
    u.id AS employer_id,
    u.first_name || ' ' || u.last_name AS employer_name,
    COUNT(p.id) AS total_projects_posted
FROM users u
LEFT JOIN projects p ON u.id = p.employer_id
WHERE u.is_admin = FALSE
GROUP BY u.id, u.first_name, u.last_name;

-- Query 4: Count of required skills for each project[cite: 2]
SELECT 
    p.id AS project_id,
    p.title AS project_title,
    COUNT(ps.skill_id) AS total_required_skills
FROM projects p
LEFT JOIN project_skills ps ON p.id = ps.project_id
GROUP BY p.id, p.title;

-- Query 1: List of open projects along with their category and employer information[cite: 2]
SELECT 
